# Teacher secrets; the teacher public key is safe to distribute
**/key/
*.key
*.pem
*.priv
!/key/
/key/*
!/key/teacher_public.key

# Never commit datasets, including encrypted archives and calibration files
/data/
*.bench

# Plaintext ground truth outside data/
/groundtruth/
**/groundtruth/
**/groundtruth.txt
**/gt.txt

# Teacher-only source and tools
/slam_bench_runner/teacher/
/slam_bench_runner/src/generated_groundtruth.cpp
/slam_bench_runner/src/embedded_groundtruth.hpp
/slam_bench_runner/src/embedded_dataset_key.hpp
/slam_bench_runner/src/benchmark_core.cpp
/slam_bench_runner/src/benchmark_input.cpp
/slam_bench_runner/src/benchmark_output.cpp

# Local run output, plots, logs, temporary calibration files
/slam_bench_runs/
/benchmark_trajectories/
/results/
*.png
*.csv
settings_session_*.yaml

# ROS 2 / CMake build products
/build/
/install/
/log/
**/build/
**/install/
**/log/
CMakeFiles/
CMakeCache.txt
*.o
*.a
*.so*

# Editors and OS files
.vscode/
.idea/
.DS_Store

# CLI implementation stays local and is compiled into libslam_bench_cli.so.
/slam_bench_runner/src/cli.cpp
